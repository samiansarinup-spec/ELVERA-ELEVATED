      ...DeploymentAuthorization
    }
    createStaticDeployment: createDeployment(provider: static, isPrivate: false) {
      ...DeploymentAuthorization
    }
    createStaticDeploymentPrivate: createDeployment(
      provider: static
      isPrivate: true
    ) {
      ...DeploymentAuthorization
    }
    redeployAutoscaleDeployment: redeployDeployment(
      provider: cloud_run
      isPrivate: false
    ) {
      ...DeploymentAuthorization
    }
    redeployAutoscaleDeploymentPrivate: redeployDeployment(
      provider: cloud_run
      isPrivate: true
    ) {
