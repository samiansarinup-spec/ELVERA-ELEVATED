    ${m}`,g=t.gql`
    fragment DeploymentSessionRepl on Repl {
  id
  __typename
  slug
  lastUsedSubdomain
  suggestedUniqueSubdomain
  config {
    isVnc
  }
  source {
    release {
      repl {
        title
      }
    }
  }
  org {
    ...DeploymentSessionOrg
  }
  owner {
    __typename
    ... on User {
      id
      username
    }
    ... on Team {
      id
      username
    }
  }
  hostingDeployment {
    ... on HostingDeployment {
      ...DeploymentSessionHostingDeployment
    }
    ... on Error {
      message
    }
  }
  hostingDeploymentPermissions {
    hasNeonProductionDatabasesEnabled
  }
  ...DeploymentAuthorizations
}
