    `,tL=tV.gql`
    query ReplAnalyticsDuration($id: String!, $input: ReplAnalyticsDurationInput!) {
  getRepl(id: $id) {
    ... on Repl {
      __typename
      id
      analyticsDuration(input: $input) {
        ... on ReplAnalyticsDuration {
          ...ReplAnalyticsDurationResult
