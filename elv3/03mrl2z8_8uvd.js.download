    query ReplitAuth($id: String!) {
  getRepl(id: $id) {
    ... on Repl {
      id
      title
      iconUrl
      timeCreated
      hasAuthUsers
      clerkAuth {
        hasClerkApp
        replitAuthMigrationStatus
      }
      authorizations {
        editMetadata {
          isAuthorized
        }
        manageAuth {
          isAuthorized
          code
          message
        }
      }
      authProviderConfig {
        ... on AuthProviderConfig {
          id
          minimizedProviders
          hideMinimizedProviders
        }
      }
      config {
        sessionSecretRotatedAt
      }
      deploymentMetadata {
        ... on DeploymentMetadata {
          id
          url
        }
      }
    }
  }
}
    `,l3=tC.gql`
    query ReplitAuthUsers($id: String!, $count: Int, $after: String, $orderBy: ReplitAuthUserOrderByInput, $filter: ReplitAuthUserFilterInput, $clerkEnvironment: ClerkEnvironment) {
  getRepl(id: $id) {
    ... on Repl {
      id
      authUsers(
        count: $count
        after: $after
        orderBy: $orderBy
        filter: $filter
        clerkEnvironment: $clerkEnvironment
      ) {
        items {
          id
          banned
          timeCreated
          lastLoggedIn
          displayName
          image
          email
          externalId
          userId
          userIdString
        }
        pageInfo {
          hasNextPage
          nextCursor
        }
      }
    }
  }
}
    `,l5=tC.gql`
    mutation UpdateReplitAuthUserBanStatus($input: UpdateReplitAuthUserBanStatusInput!) {
  updateReplitAuthUserBanStatus(input: $input) {
    ... on UpdateReplitAuthUserBanStatusOutput {
      success
      message
      user {
        id
        banned
      }
    }
    ... on NotFoundError {
      message
    }
    ... on UnauthorizedError {
      message
    }
  }
}
    `,l6=tC.gql`
    subscription MigrateReplitAuthToClerk($replId: String!) {
  migrateReplitAuthToClerk(replId: $replId) {
    status
    totalUsers
    errorMessage
